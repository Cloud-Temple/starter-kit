# =============================================================================
# Configuration du service MCP — Copier en .env et adapter
# =============================================================================

# --- Serveur MCP ---
MCP_SERVER_NAME=mon-mcp-service
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8002

# --- Branding admin UI ---
# Valeurs: ct (Cloud Temple), dgy (Dragonfly), isec (Intrinsec)
MCP_BRAND=ct

# --- WAF ---
WAF_PORT=8082

# --- Auth ---
# Clé de bootstrap pour le premier accès admin.
# ⚠️  Changer en production ! (minimum 64 caractères aléatoires)
ADMIN_BOOTSTRAP_KEY=change_me_in_production

# --- Token Store backend ---
# Valeurs: s3 (défaut), vault (à venir)
TOKEN_STORE_BACKEND=s3
TOKEN_STORE_CACHE_TTL=300
TOKEN_STORE_FAIL_MODE=fail_close

# --- MCP Vault Token Store (si TOKEN_STORE_BACKEND=vault) ---
MCP_VAULT_URL=https://vault.mcp.cloud-temple.app
MCP_VAULT_TOKEN_FILE=
MCP_VAULT_TOKEN=
MCP_VAULT_ID=
MCP_VAULT_TOKEN_STORE_PATH=token-store/tokens.json
MCP_VAULT_TIMEOUT=5

# --- S3 Token Store (optionnel) ---
# Si configuré, les tokens d'accès sont persistés sur S3.
# Si vide, seul le bootstrap key fonctionne (mode développement).
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=fr1
# Cloud Temple / Dell ECS data operations require SigV2 ("s3").
# Use "s3v4" if your S3 provider requires Signature V4.
S3_SIGNATURE_VERSION=s3
S3_ADDRESSING_STYLE=path

# --- Proxy HTTP sortant (optionnel) ---
# À injecter manuellement dans vos clients httpx/boto3 via settings.proxy_url.
# Doit être une URL complète avec schéma (http:// ou https://).
PROXY_URL=

# --- JWT / OIDC (optionnel — Keycloak, Entra ID, Okta, etc.) ---
# Si les 3 variables ci-dessous sont définies, la validation JWT est activée
# en complément du Token Store S3 et du bootstrap key.
# Le fichier JWKS doit être disponible LOCALEMENT dans le container (pas de fetch réseau).
# Exemple de montage Docker : -v /etc/sso/jwks.json:/app/certs/jwks.json:ro
JWT_ISSUER=
JWT_AUDIENCE=
JWKS_FILE=

# --- Vos services métier (exemples) ---
# DATABASE_URL=postgresql://user:pass@db:5432/mydb
# REDIS_URL=redis://redis:6379/0
# EXTERNAL_API_KEY=
# EXTERNAL_API_URL=https://api.example.com
