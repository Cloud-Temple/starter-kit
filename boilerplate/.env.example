# =============================================================================
# Configuration du service MCP — Copier en .env et adapter
# =============================================================================

# --- Serveur MCP ---
MCP_SERVER_NAME=mon-mcp-service
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8002

# --- Branding admin UI ---
# Valeurs: ct (Cloud Temple), dgy (Dragonfly), isec (Intrinsec)
MCP_BRAND=ct

# --- WAF ---
WAF_PORT=8082

# --- Auth ---
# Clé de bootstrap pour le premier accès admin.
# ⚠️  Changer en production ! (minimum 64 caractères aléatoires)
ADMIN_BOOTSTRAP_KEY=change_me_in_production

# --- Token Store backend ---
# Valeurs: s3 (défaut), vault (à venir)
TOKEN_STORE_BACKEND=s3
TOKEN_STORE_CACHE_TTL=300
TOKEN_STORE_FAIL_MODE=fail_close

# --- MCP Vault Token Store (si TOKEN_STORE_BACKEND=vault) ---
MCP_VAULT_URL=https://vault.mcp.cloud-temple.app
MCP_VAULT_TOKEN_FILE=
MCP_VAULT_TOKEN=
MCP_VAULT_ID=
MCP_VAULT_TOKEN_STORE_PATH=token-store/tokens.json
MCP_VAULT_TIMEOUT=5

# --- S3 Token Store (optionnel) ---
# Si configuré, les tokens d'accès sont persistés sur S3.
# Si vide, seul le bootstrap key fonctionne (mode développement).
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=fr1
# Cloud Temple / Dell ECS data operations require SigV2 ("s3").
# Use "s3v4" if your S3 provider requires Signature V4.
S3_SIGNATURE_VERSION=s3
S3_ADDRESSING_STYLE=path

# --- Proxy HTTP sortant (optionnel) ---
# À injecter manuellement dans vos clients httpx/boto3 via settings.proxy_url.
# Doit être une URL complète avec schéma (http:// ou https://).
PROXY_URL=

# --- JWT / OIDC (optionnel — Keycloak, Entra ID, Okta, etc.) ---
# Si les 3 variables ci-dessous sont définies, la validation JWT est activée
# en complément du Token Store S3 et du bootstrap key.
# Le fichier JWKS doit être disponible LOCALEMENT dans le container (pas de fetch réseau).
# Exemple de montage Docker : -v /etc/sso/jwks.json:/app/certs/jwks.json:ro
JWT_ISSUER=
JWT_AUDIENCE=
JWKS_FILE=

# --- Mission JWT (mission_token mcp-mission, ES256 via JWKS dynamique) ---
# AuthMissionJWTMiddleware valide le mission_token signé ES256 émis par
# mcp-mission (PEP côté MCP). Cf. starter-kit#14 et mcp-mission §17.10/§17.12.
#
# STARTER_KIT_AUTH_MODE :
#   bearer      (défaut) → middleware inactif, auth Bearer legacy uniquement
#   jwt                  → SEUL le mission_token JWT est accepté (fail-close).
#                          Le Bearer legacy est REFUSÉ pour les appels mission.
#                          À utiliser pour mcp-vault (P1) et mcp-teleport (P2) :
#                          dual-stack INTERDIT avant la GA V1 de mcp-mission.
#   dual-stack           → JWT validé s'il est présenté ; sinon fallback Bearer
#                          legacy (P3-P7, migration progressive). ATTENTION : un
#                          JWT présenté mais invalide est refusé (pas de fail-open).
STARTER_KIT_AUTH_MODE=bearer

# Identifiant d'instance unique de CE MCP (obligatoire en mode jwt/dual-stack).
# Le middleware refuse tout token dont `aud` ne le contient pas (anti audience
# confusion T03 / resource binding T11).
MCP_INSTANCE_ID=

# Genre (kind) de ce MCP dans le claim `component_id` du token (ex: vault,
# teleport, live_memory). Le middleware vérifie component_id[<kind>]==MCP_INSTANCE_ID.
MCP_COMPONENT_KIND=

# URL du JWKS public de mcp-mission.
MCP_MISSION_JWKS_URL=

# TTL du cache JWKS en secondes (défaut 300 = 5 min).
JWKS_CACHE_TTL_SECONDS=300

# Skew toléré sur `iat` (anti-rejeu d'horloge avancée), en secondes (défaut 60).
MISSION_JWT_IAT_LEEWAY_SECONDS=60

# --- Vos services métier (exemples) ---
# DATABASE_URL=postgresql://user:pass@db:5432/mydb
# REDIS_URL=redis://redis:6379/0
# EXTERNAL_API_KEY=
# EXTERNAL_API_URL=https://api.example.com
